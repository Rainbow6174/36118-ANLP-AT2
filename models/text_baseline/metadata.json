{
  "model_version": "baseline-v1",
  "model_name": "word_char_tfidf_logistic_regression",
  "model_artifact": "model.joblib",
  "task": "HumAID text-only humanitarian classification",
  "data": {
    "train_rows": 53531,
    "validation_rows": 7793,
    "test_rows": 15160
  },
  "environment": {
    "python": "3.11.16",
    "scikit_learn": "1.9.1",
    "joblib": "1.6.0"
  },
  "canonical_label_order": [
    "caution_and_advice",
    "displaced_people_and_evacuations",
    "infrastructure_and_utility_damage",
    "injured_or_dead_people",
    "missing_or_found_people",
    "not_humanitarian",
    "other_relevant_information",
    "requests_or_urgent_needs",
    "rescue_volunteering_or_donation_effort",
    "sympathy_and_support"
  ],
  "preprocessing": {
    "function": "models.text_baseline.baseline.clean_text",
    "operations": [
      "remove URLs",
      "replace @mentions with @user",
      "remove # while retaining hashtag text",
      "collapse repeated whitespace",
      "strip leading/trailing whitespace"
    ]
  },
  "feature_pipeline": {
    "combiner": "FeatureUnion",
    "word_tfidf": {
      "analyzer": "word",
      "ngram_range": [
        1,
        2
      ],
      "min_df": 5,
      "max_features": 12000,
      "sublinear_tf": true
    },
    "char_tfidf": {
      "analyzer": "char",
      "ngram_range": [
        3,
        5
      ],
      "min_df": 10,
      "max_features": 16000,
      "sublinear_tf": true
    }
  },
  "classifier": {
    "type": "LogisticRegression",
    "C": 1.0,
    "class_weight": null,
    "solver": "lbfgs",
    "max_iter": 1000,
    "random_state": 42
  },
  "probability": {
    "method": "native_logistic_regression_predict_proba",
    "calibration_assessed": true,
    "additional_calibration_applied": false,
    "confidence_definition": "max_predict_proba",
    "ece_bins": 15,
    "ece_method": "top_label_equal_width"
